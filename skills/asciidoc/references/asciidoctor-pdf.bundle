<document path="asciidoctor-pdf/spec/ignore-gem-warnings.rb" lines="11">
# frozen_string_literal: true

module Warning
  module Processor
    def warn str
      super unless str.start_with?(*Gem.path)
    end
  end

  extend Processor
end
