        end
      end

      pdf = to_pdf <<~'END', backend: backend, analyze: true
      = Document Title
      :toc:

      == Beginning

      content

      == End

      content
      END

      (expect (pdf.find_unique_text 'Table of Contents')).to be_nil
      (expect (pdf.find_text 'Beginning')).to have_size 1
    end

