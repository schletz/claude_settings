  subtitle:
    font-kerning: none

|font-size
|xref:text.adoc#font-size[Font size] +
(default: `14`)
|[source]
title-page:
  subtitle:
    font-size: $heading-h3-font-size

|font-style
|xref:text.adoc#font-style[Font style] +
(default: _inherit_)
|[source]
