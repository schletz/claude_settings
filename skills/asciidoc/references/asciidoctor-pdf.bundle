    (expect pdf.text[0][:font_size].floor).to be 7
  end

  it 'should use base font color if font color is not specified' do
    pdf = to_pdf <<~'END', pdf_theme: { base_font_color: 'AA0000', code_font_color: nil }, analyze: true
    before

    ----
    in the mix
    ----
    END

