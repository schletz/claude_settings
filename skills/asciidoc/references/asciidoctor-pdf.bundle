  subtitle:
    font-style: bold_italic

|line-height
|xref:language.adoc#values[Number] +
(default: `$heading-line-height`)
|[source]
title-page:
  subtitle:
    line-height: 1

|margin-bottom
|xref:measurement-units.adoc[Measurement] +
(default: `0`)
|[source]
title-page:
  subtitle:
    margin-bottom: 5

|margin-top
|xref:measurement-units.adoc[Measurement] +
(default: `0`)
|[source]
title-page:
  subtitle:
    margin-top: 13.125

|text-transform
|xref:text.adoc#transform[Text transform] +
(default: _inherit_)
|[source]
