  BackgroundColor #ffffff
  BorderColor #1d1d1b
  BorderThickness 1.5
}
skinparam artifact {
  BackgroundColor #d1ebf7
  BorderColor #1d1d1b
}
skinparam folder {
  BackgroundColor #ffffff
  BorderColor #1d1d1b
}
skinparam node {
  BackgroundColor #ededed
  BorderColor #1d1d1b
}
skinparam cloud {
  BackgroundColor #fdebd1
  BorderColor #1d1d1b
}
skinparam activity {
  BackgroundColor #ffffff
